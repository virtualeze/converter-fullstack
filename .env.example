# Porta e interface de rede
PORT=3000
HOST=0.0.0.0

# Limite global para arquivos enviados pelas rotas de conversão.
# Ajuste para 2048 se quiser manter o limite local de 2 GB.
MAX_FILE_SIZE_MB=500

# Limpeza automática de arquivos temporários.
# 3600000 = 1 hora.
TEMP_FILE_TTL_MS=3600000

# Proteção contra excesso de requisições nas operações pesadas.
RATE_LIMIT_WINDOW_MS=600000
RATE_LIMIT_MAX_REQUESTS=20

# Caminhos opcionais. Se vazios, o sistema procura os executáveis no PATH.
FFMPEG_PATH=
YTDLP_PATH=
LIBREOFFICE_PATH=

# Domínios permitidos para download via URL, separados por vírgula.
ALLOWED_MEDIA_DOMAINS=youtube.com,youtu.be,tiktok.com,instagram.com,x.com,twitter.com,facebook.com,fb.watch,vimeo.com,dailymotion.com
